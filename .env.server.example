# Copy to `.env` next to compose.traefik.yaml on the droplet
# (/opt/apps/projects/sspx-catechism/.env) and fill in real values.
# NEVER commit the real .env — it holds secrets.
#
# Note: the public hostname and TLS are handled by the shared Traefik proxy;
# the host is set in compose.traefik.yaml's Traefik labels, so there is no
# DOMAIN variable here.

# --- Postgres ---
POSTGRES_USER=catechism
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=catechism

# Connection string the Go API uses (host "db" = the compose service name)
DATABASE_URL=postgres://catechism:change-me-strong-random@db:5432/catechism?sslmode=disable

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-long-random-secret

# --- Admin bootstrap (created ONLY IF MISSING on API startup) ---
# The admin is created on first boot. On later boots it is left untouched, so a
# password changed in the app is never reverted by a deploy.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-strong-admin-password
# Escape hatch: set to "true" for a single boot to force-reset the existing
# admin's password/role/active state from ADMIN_PASSWORD (recover a lockout),
# then remove it. Leave unset/false in normal operation.
# ADMIN_FORCE_RESET=false

# --- Backup → DigitalOcean Spaces (S3-compatible; used by scripts/backup.sh) ---
# Create a Space + an access key in the DO console (API → Spaces Keys).
SPACES_BUCKET=catechism-backups
SPACES_REGION=nyc3
# Optional: object key prefix inside the bucket (default: catechism-backups).
# SPACES_PREFIX=catechism-backups
# Optional: override the endpoint (default: https://<region>.digitaloceanspaces.com).
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=change-me-spaces-access-key
AWS_SECRET_ACCESS_KEY=change-me-spaces-secret-key
# Passphrase used to symmetrically encrypt dumps (gpg AES256). Keep it safe & offline too.
BACKUP_PASSPHRASE=change-me-backup-encryption-passphrase
# Retention (days) for daily dumps
BACKUP_RETENTION_DAYS=14
